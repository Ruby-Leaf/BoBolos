// ---------- Pop_ups presets

qnt_selecionada = 0;

// ---------- Pop_ups dimenções

pop_up_h = min(400, room_height / 2);
pop_up_w = room_width / 2 * .9;

botao_confirm_h = min(70, room_height / 2);
botao_confirm_w = room_width / 2 * .2;

botao_selector_h = min(40, room_height / 2);
botao_selector_w = room_width / 2 * .06;

botao_exit_h = min(50, room_height / 2);
botao_exit_w = room_width / 2 * .05;